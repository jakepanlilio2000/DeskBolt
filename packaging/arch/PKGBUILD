# Maintainer: StackSync Solutions <jakepanlilio2000>
pkgname=deskbolt
pkgver=0.1.0_beta1
pkgrel=1
pkgdesc="Native self-hosted remote desktop server and viewer"
arch=('x86_64')
url="https://github.com/jakepanlilio2000/DeskBolt"
license=('MPL-2.0')
depends=('glibc' 'libxcb' 'libxrandr' 'dbus' 'libxkbcommon' 'libxkbcommon-x11' 'libglvnd')
makedepends=('rust' 'cargo' 'clang' 'nasm' 'pipewire')

build() {
  cd "${startdir}/../.."
  cargo build --release --workspace --no-default-features --locked
}

package() {
  cd "${startdir}/../.."
  install -Dm755 "target/release/deskbolt-server" "${pkgdir}/usr/bin/deskbolt-server"
  install -Dm755 "target/release/deskbolt-viewer" "${pkgdir}/usr/bin/deskbolt-viewer"
  install -Dm644 "packaging/linux/deskbolt-server.service" "${pkgdir}/usr/lib/systemd/system/deskbolt-server.service"
  install -Dm644 "packaging/linux/deskbolt-viewer.desktop" "${pkgdir}/usr/share/applications/deskbolt-viewer.desktop"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
